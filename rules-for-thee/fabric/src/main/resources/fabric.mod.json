{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "chimericdream"
    ],
    "contact": {
        "homepage": "https://fabricmc.net/",
        "sources": "https://github.com/FabricMC/fabric-example-mod"
    },
    "license": "MIT",
    "icon": "assets/rulesforthee/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.chimericdream.rulesforthee.fabric.RulesForTheeFabric"
        ],
        "client": [
            "com.chimericdream.rulesforthee.fabric.client.RulesForTheeFabricClient"
        ]
    },
    "mixins": [
        "rulesforthee.mixins.json",
        "rulesforthee.compat.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_compat}",
        "minecraft": "~${minecraft_compat}",
        "java": ">=25",
        "fabric-api": "*",
        "architectury": ">=${architectury_compat}",
        "chimericlib": ">=${chimericlib_compat}"
    }
}
