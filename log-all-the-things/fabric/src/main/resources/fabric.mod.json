{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "chimericdream"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/log-all-the-things",
        "sources": "https://github.com/chimericdream/minecraft-mods/log-all-the-things"
    },
    "license": "MIT",
    "icon": "assets/logallthethings/icon.gif",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.chimericdream.logallthethings.fabric.LogAllTheThingsFabric"
        ],
        "client": [
            "com.chimericdream.logallthethings.fabric.client.LogAllTheThingsFabricClient"
        ]
    },
    "mixins": [
        "logallthethings.mixins.json",
        "logallthethings.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_compat}",
        "minecraft": "~${minecraft_compat}",
        "java": ">=25",
        "fabric-api": "*",
        "architectury": ">=${architectury_compat}",
        "chimericlib": ">=${chimericlib_compat}",
        "yet_another_config_lib_v3": ">=${yacl_compat}"
    },
    "recommends": {
        "modmenu": ">=${modmenu_compat}"
    }
}
