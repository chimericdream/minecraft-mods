{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "chimericdream"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/but-what-about",
        "sources": "https://github.com/chimericdream/but-what-about"
    },
    "license": "MIT",
    "icon": "assets/butwhatabout/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.chimericdream.butwhatabout.fabric.ButWhatAboutFabric"
        ],
        "client": [
            "com.chimericdream.butwhatabout.fabric.client.ButWhatAboutFabricClient"
        ],
        "fabric-datagen": [
            "com.chimericdream.butwhatabout.fabric.data.ModDataGenerator"
        ]
    },
    "mixins": [
        "butwhatabout.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_compat}",
        "minecraft": "~${minecraft_compat}",
        "java": ">=25",
        "fabric-api": "*",
        "architectury": ">=${architectury_compat}",
        "chimericlib": ">=${chimericlib_compat}"
    },
    "recommends": {
        "modmenu": ">=${modmenu_compat}"
    }
}
